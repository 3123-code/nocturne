# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Real Email Delivery (SMTP) Configuration:
# To deliver OTP verification emails directly to real external inboxes (e.g., Gmail):
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="Nocturne Security <security@nocturne.network>"

